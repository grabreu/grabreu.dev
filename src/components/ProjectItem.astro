---
import type { Project } from "../data/content";

interface Props extends Project {
  demoLabel: string;
  sourceLabel: string;
}

const {
  name,
  description,
  tags,
  demoHref,
  packageHref,
  packageLabel,
  sourceHref,
  demoLabel,
  sourceLabel,
} = Astro.props;
---

<li class="mb-12">
	<div>
		<h3 class="text-lg font-semibold text-ink">{name}</h3>
		<p class="mt-2 text-sm leading-normal text-muted">{description}</p>

		<ul class="mt-3 flex flex-wrap gap-2" aria-label="Technologies used">
			{
				tags.map((tag) => (
					<li class="rounded border border-line px-2 py-0.5 text-xs font-semibold text-ink">
						{tag}
					</li>
				))
			}
		</ul>

		<div class="mt-3 flex gap-4 text-sm font-semibold text-route">
			<a href={sourceHref} target="_blank" rel="noreferrer noopener" class="hover:text-signal">
				{sourceLabel}
			</a>
			{
				demoHref && (
					<a href={demoHref} target="_blank" rel="noreferrer noopener" class="hover:text-signal">
						{demoLabel}
					</a>
				)
			}
			{
				packageHref && (
					<a href={packageHref} target="_blank" rel="noreferrer noopener" class="hover:text-signal">
						{packageLabel}
					</a>
				)
			}
		</div>
	</div>
</li>
