---
import type { SiteContent } from "../data/content";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  content: SiteContent;
}

const { content: c } = Astro.props;
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24">
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      <a href="/">{c.name}</a>
    </h1>

    <h2 class="mt-3 text-lg font-medium tracking-tight text-ink sm:text-xl">{c.role}</h2>

    <p class="mt-4 max-w-xs leading-normal">{c.tagline}</p>

    <nav class="hidden lg:block" aria-label="In-page jump links">
      <ul class="mt-16 w-max">
        {
          c.nav.map((item) => (
            <li>
              <a class="group flex items-center py-3" href={item.href}>
                <span class="mr-4 h-px w-8 bg-line transition-all group-hover:w-16 group-hover:bg-signal group-focus-visible:w-16 group-focus-visible:bg-signal motion-reduce:transition-none" />
                <span class="text-xs font-bold uppercase tracking-widest text-muted group-hover:text-ink group-focus-visible:text-ink">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div>
    <SocialLinks />
    <a
      href={c.langSwitchHref}
      class="ml-1 mt-6 inline-block text-xs font-bold uppercase tracking-widest text-muted hover:text-ink"
    >
      {c.langSwitchLabel}
    </a>
  </div>
</header>
