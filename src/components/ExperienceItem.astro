---
import type { Experience } from "../data/content";

interface Props extends Experience {}

const { period, role, company, description, tags } = Astro.props;
---

<li class="mb-12">
  <div class="grid gap-1 sm:grid-cols-8 sm:gap-8">
    <header class="mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-muted sm:col-span-2">
      {period}
    </header>

    <div class="sm:col-span-6">
      <h3 class="font-medium leading-snug text-ink">
        {role} · <span class="inline-block">{company}</span>
      </h3>
      <p class="mt-2 text-sm leading-normal text-muted">{description}</p>
      <ul class="mt-2 flex flex-wrap gap-2" aria-label="Technologies used">
        {
          tags.map((tag) => (
            <li class="rounded border border-line px-2 py-0.5 text-xs font-semibold text-ink">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</li>
